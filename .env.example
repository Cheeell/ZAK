# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Comma-separated Telegram user IDs of admins
ADMIN_IDS=123456789,987654321

# Server port
PORT=3000

# HTTPS URL of your deployed app (required for Telegram WebApp)
# On Koyeb this will be something like: https://your-app-xxx.koyeb.app
WEBAPP_URL=https://your-app.koyeb.app

# Database path (for Koyeb persistent disk, use /data/merch.db)
DB_PATH=/data/merch.db
